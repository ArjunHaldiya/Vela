# --- Server-side (set on Cloud Run with --set-env-vars, or in .env.local) ---
GROQ_API_KEY=              # console.groq.com: chat, vision OCR and Whisper
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_STT_MODEL=whisper-large-v3-turbo
GOOGLE_API_KEY=            # Optional: Cloud Vision OCR (preferred over Llama vision when set) + Cloud Text-to-Speech

# --- Public Firebase web config (not secret). Put these in .env.production for Cloud Run builds ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Demo contacts (use teammates' real phone/email so the demo actually rings and emails) ---
NEXT_PUBLIC_DEMO_PHARMACY_PHONE=+14155550123
NEXT_PUBLIC_DEMO_PHARMACY_EMAIL=pharmacy@example.com
NEXT_PUBLIC_DEMO_DOCTOR_EMAIL=doctor@example.com
NEXT_PUBLIC_DEMO_CAREGIVER_EMAIL=caregiver@example.com
