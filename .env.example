# --- Server-side (set on Cloud Run with --set-env-vars, or in .env.local) ---
GEMINI_API_KEY=            # AI Studio key: Gemini + Gemma 4
GOOGLE_API_KEY=            # Cloud key with Cloud Vision + Cloud Text-to-Speech enabled
GEMINI_MODEL=gemini-flash-latest
GEMMA_MODEL=gemma-4-26b-a4b-it
# Optional: route Gemini through Vertex AI on the hackathon credits (uses Cloud Run's service account)
USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Public Firebase web config (not secret). Put these in .env.production for Cloud Run builds ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Demo contacts (use teammates' real phone/email so the demo actually rings and emails) ---
NEXT_PUBLIC_DEMO_PHARMACY_PHONE=+14155550123
NEXT_PUBLIC_DEMO_PHARMACY_EMAIL=pharmacy@example.com
NEXT_PUBLIC_DEMO_DOCTOR_EMAIL=doctor@example.com
NEXT_PUBLIC_DEMO_CAREGIVER_EMAIL=caregiver@example.com
