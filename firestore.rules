rules_version = '2';
// DEMO RULES: any signed-in (anonymous) session can read/write synthetic demo data.
// Production: role-based rules keyed on the patient's consent map (see README).
service cloud.firestore {
  match /databases/{database}/documents {
    match /patients/{pid} {
      allow read, write: if request.auth != null;
      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
